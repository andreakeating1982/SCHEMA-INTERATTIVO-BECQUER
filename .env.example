# ============================================================
# .env.example — SCHEMA INTERATTIVO
# Copia questo file in .env e modifica i valori
# ============================================================
#
# Se usi Render Blueprint (render.yaml), non serve un .env:
#   Render configura tutto automaticamente.
#
# Se fai deploy manuale, imposta almeno DATABASE_URL
# e BETTER_AUTH_SECRET qui sotto (o come variabili d'ambiente).
#
# ============================================================

# --- Database PostgreSQL (OBBLIGATORIO) ---
DATABASE_URL=postgresql://utente:password@host:5432/db

# --- Segreto per le sessioni (OBBLIGATORIO) ---
# Generane uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Ambiente ---
NODE_ENV=production

# --- URL pubblici attendibili (CORS/cookie) ---
# In produzione aggiungi il tuo dominio (es. https://schema-interattivo.onrender.com)
TRUSTED_ORIGINS=

# --- URL pubblico dell'app (opzionale) ---
# Necessario solo per l'autenticazione OAuth
BETTER_AUTH_URL=https://schema-interattivo.onrender.com

# --- OAuth providers (opzionali, lascia vuoto per disabilitare) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
